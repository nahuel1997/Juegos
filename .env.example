# Secreto para firmar las sesiones. Generar uno largo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame
# true si hay HTTPS adelante (Nginx del host). false solo para probar por HTTP plano.
COOKIE_SEGURA=true
# Dónde escucha el contenedor web (por defecto solo localhost, para ponerle Nginx del host adelante).
WEB_BIND=127.0.0.1
WEB_PORT=4400
